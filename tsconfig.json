{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",

    "lib": ["ESNext"],
    "target": "ESNext",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": true,

    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"]
}
